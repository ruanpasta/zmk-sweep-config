#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        ht: hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <220>;
            quick-tap-ms = <100>;
            require-prior-idle-ms = <100>;
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        settings {
            bindings = <&sl 4>;
            key-positions = <30 31>;
            timeout-ms = <300>;
        };

        layer_toggle {
            bindings = <&mo 5>;
            key-positions = <33 32>;
            timeout-ms = <150>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp SQT        &kp COMMA  &kp PERIOD  &kp P  &kp Y        &kp F          &kp G  &kp C  &kp R  &kp L
&kp A          &kp O      &kp E       &kp U  &kp I        &kp D          &kp H  &kp T  &kp N  &kp S
&kp SEMICOLON  &kp Q      &kp J       &kp K  &kp X        &kp B          &kp M  &kp W  &kp V  &kp Z
                                      &mo 2  &kp SPACE    &kp BACKSPACE  &sl 1
            >;
        };

        layer_1 {
            bindings = <
&kp NUMBER_1     &kp NUMBER_2  &kp NUMBER_3      &kp NUMBER_4          &kp N5            &kp NUMBER_6     &kp N7                 &kp N8             &kp N9           &kp N0
&kp EXCLAMATION  &kp AT_SIGN   &kp HASH          &kp DOLLAR            &kp PERCENT       &kp CARET        &kp AMPERSAND          &kp ASTERISK       &mt UNDER PLUS   &mt PIPE QUESTION
&kp GRAVE        &kp TILDE     &kp LEFT_BRACKET  &kp LEFT_PARENTHESIS  &kp LEFT_BRACE    &kp RIGHT_BRACE  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACKET  &mt EQUAL MINUS  &mt BACKSLASH SLASH
                                                 &mo 3                 &trans            &trans           &trans
            >;
        };

        layer_2 {
            bindings = <
&kp ESC           &kp LC(A)       &kp LC(O)     &kp LC(P)     &kp LC(Y)    &kp LC(F)  &kp LC(G)  &kp LC(C)  &kp LC(R)     &kp DELETE
&sk LEFT_CONTROL  &sk LEFT_SHIFT  &sk LEFT_ALT  &sk LEFT_GUI  &kp TAB      &kp ENTER  &kp LEFT   &kp DOWN   &kp UP_ARROW  &kp RIGHT
&kp LC(S)         &kp LC(Q)       &kp LC(J)     &kp LC(K)     &kp LC(X)    &kp LC(B)  &kp LC(M)  &kp LC(W)  &kp LC(V)     &kp LC(Z)
                                                &trans        &trans       &trans     &mo 3
            >;
        };

        layer_3 {
            bindings = <
&trans            &trans          &trans        &trans        &trans    &kp PRINTSCREEN  &kp F1  &kp F2   &kp F3   &kp F4
&sk LEFT_CONTROL  &sk LEFT_SHIFT  &sk LEFT_ALT  &sk LEFT_GUI  &trans    &kp C_AC_PRINT   &kp F5  &kp F6   &kp F7   &kp F8
&trans            &trans          &trans        &trans        &trans    &trans           &kp F9  &kp F10  &kp F11  &kp F12
                                                &trans        &trans    &trans           &trans
            >;
        };

        layer_settings {
            bindings = <
&bootloader  &trans  &trans  &bt BT_CLR  &bt BT_SEL 0    &trans  &trans  &trans  &trans  &bootloader
&trans       &trans  &trans  &trans      &bt BT_SEL 1    &trans  &trans  &trans  &trans  &trans
&trans       &trans  &trans  &trans      &bt BT_SEL 3    &trans  &trans  &trans  &trans  &trans
                             &trans      &trans          &trans  &trans
            >;
        };

        layer_toggle {
            bindings = <
&to 7   &trans  &trans  &trans  &to 6     &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
&to 8   &trans  &trans  &trans  &to 0     &trans  &trans  &trans  &trans  &trans
                        &trans  &trans    &trans  &trans
            >;
        };

        layer_tibia {
            bindings = <
&kp ESC           &kp Q           &kp UP_ARROW    &kp E            &kp F16      &kp F13  &kp F1  &kp F2   &kp F3   &kp F4
&kp LEFT_CONTROL  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp F17      &kp F14  &kp F5  &kp F6   &kp F7   &kp F8
&kp LEFT_SHIFT    &kp Z           &kp F19         &kp C            &kp F18      &kp F15  &kp F9  &kp F10  &kp F11  &kp F12
                                                  &trans           &kp SPACE    &trans   &trans
            >;
        };

        layer_lol {
            bindings = <
&kp ESC           &kp Q  &kp W                  &kp E    &kp R           &trans  &trans  &trans  &kp P   &trans
&kp LEFT_CONTROL  &kp A  &ht LEFT_ALT NUMBER_1  &kp D    &kp F           &trans  &trans  &trans  &trans  &trans
&kp NUMBER_3      &kp Z  &kp NUMBER_2           &kp X    &kp NUMBER_4    &kp B   &trans  &trans  &trans  &trans
                                                &kp TAB  &trans          &trans  &trans
            >;
        };

        layer_cs {
            bindings = <
&kp NUMBER_1      &kp NUMBER_2  &kp W         &kp E         &kp R           &kp Y   &trans  &trans  &kp P   &trans
&kp LEFT_CONTROL  &kp A         &kp S         &kp D         &kp G           &trans  &trans  &trans  &trans  &trans
&kp LEFT_SHIFT    &kp Z         &kp NUMBER_5  &kp NUMBER_3  &kp NUMBER_4    &kp B   &trans  &trans  &trans  &trans
                                              &kp TAB       &trans          &trans  &trans
            >;
        };
    };
};
