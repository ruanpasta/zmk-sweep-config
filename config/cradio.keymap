// Cradio home row mod tap keymaps

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        ht: hold_tap {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <150>;
            quick-tap-ms = <100>;
            require-prior-idle-ms = <100>;
            bindings = <&kp>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        settings {
            bindings = <&sl 7>;
            key-positions = <31 30>;
            timeout-ms = <250>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp SQT      &kp COMMA         &kp PERIOD      &kp P           &kp Y        &kp F          &kp G            &kp C            &kp R              &kp L
&ht LCTRL A  &ht LEFT_SHIFT O  &ht LEFT_ALT E  &ht LEFT_GUI U  &kp I        &kp D          &ht RIGHT_GUI H  &ht RIGHT_ALT T  &ht RIGHT_SHIFT N  &ht RCTRL S
&lt 2 SEMI   &kp Q             &kp J           &kp K           &kp X        &kp B          &kp M            &kp W            &kp V              &kp Z
                                               &lt 1 TAB       &kp SPACE    &kp BACKSPACE  &lt 8 ENTER
            >;
        };

        layer_1 {
            bindings = <
&kp NUMBER_1     &kp NUMBER_2  &kp NUMBER_3      &kp NUMBER_4          &kp N5            &kp NUMBER_6     &kp N7                 &kp N8             &kp N9         &kp N0
&kp EXCLAMATION  &kp AT_SIGN   &kp HASH          &kp DOLLAR            &kp PERCENT       &kp CARET        &kp AMPERSAND          &kp ASTERISK       &kp SLASH      &kp QUESTION
&kp GRAVE        &kp TILDE     &kp LEFT_BRACKET  &kp LEFT_PARENTHESIS  &kp LEFT_BRACE    &kp RIGHT_BRACE  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACKET  &kp BACKSLASH  &kp PIPE
                                                 &trans                &trans            &trans           &trans
            >;
        };

        layer_funcions {
            bindings = <
&trans  &trans  &trans  &trans  &trans    &trans  &kp F1  &kp F2   &kp F3   &kp F4
&trans  &trans  &trans  &trans  &trans    &trans  &kp F5  &kp F6   &kp F7   &kp F8
&trans  &trans  &trans  &trans  &trans    &trans  &kp F9  &kp F10  &kp F11  &kp F12
                        &trans  &trans    &trans  &trans
            >;
        };

        layer_type {
            bindings = <
&kp SQT     &kp COMMA  &kp PERIOD  &kp P   &kp Y     &kp F   &kp G   &kp C  &kp R  &kp L
&kp A       &kp O      &kp E       &kp U   &kp I     &kp D   &kp H   &kp T  &kp N  &kp S
&lt 2 SEMI  &kp Q      &kp J       &kp K   &kp X     &kp B   &kp M   &kp W  &kp V  &kp Z
                                   &trans  &trans    &trans  &trans
            >;
        };

        layer_tibia {
            bindings = <
&kp ESC           &kp N7          &kp UP_ARROW    &kp N9           &kp F16      &kp F13        &kp F1  &kp F2   &kp F3   &kp F4
&kp LEFT_CONTROL  &kp LEFT_ARROW  &kp DOWN_ARROW  &kp RIGHT_ARROW  &kp F17      &kp F14        &kp F5  &kp F6   &kp F7   &kp F8
&kp LEFT_SHIFT    &kp N1          &kp F19         &kp NUMBER_3     &kp F18      &kp F15        &kp F9  &kp F10  &kp F11  &kp F12
                                                  &kp TAB          &kp SPACE    &kp BACKSPACE  &trans
            >;
        };

        layer_lol {
            bindings = <
&kp ESC           &kp Q  &kp W                  &kp E    &kp R           &trans         &trans  &trans  &kp P   &trans
&kp LEFT_CONTROL  &kp A  &ht LEFT_ALT NUMBER_1  &kp D    &kp F           &trans         &trans  &trans  &trans  &trans
&kp NUMBER_3      &kp Z  &kp NUMBER_2           &kp X    &kp NUMBER_4    &kp B          &trans  &trans  &trans  &trans
                                                &kp TAB  &kp SPACE       &kp BACKSPACE  &trans
            >;
        };

        layer_cs {
            bindings = <
&kp E             &kp NUMBER_1  &kp W         &kp NUMBER_3  &kp R           &trans         &trans  &trans  &kp P   &kp ESCAPE
&kp LEFT_CONTROL  &kp A         &kp S         &kp D         &kp G           &trans         &trans  &trans  &trans  &trans
&kp LEFT_SHIFT    &kp NUMBER_2  &kp NUMBER_5  &kp K         &kp NUMBER_4    &kp B          &trans  &trans  &trans  &trans
                                              &kp TAB       &kp SPACE       &kp BACKSPACE  &trans
            >;
        };

        settings {
            bindings = <
&bootloader  &trans  &trans  &bt BT_CLR  &bt BT_SEL 0    &kp PRINTSCREEN  &trans  &trans  &trans  &bootloader
&trans       &trans  &trans  &trans      &bt BT_SEL 1    &kp C_AC_PRINT   &trans  &trans  &trans  &trans
&trans       &trans  &trans  &trans      &bt BT_SEL 3    &trans           &trans  &trans  &trans  &kp KP_NUMLOCK
                             &trans      &trans          &trans           &trans
            >;
        };

        layer_2 {
            bindings = <
&kp ESC  &kp DELETE      &kp C_PREVIOUS     &kp C_PLAY_PAUSE  &kp C_NEXT         &kp PLUS   &mmv MOVE_LEFT  &msc SCRL_DOWN  &msc SCRL_UP  &msc SCRL_RIGHT
&trans   &kp UNDERSCORE  &kp C_VOLUME_DOWN  &kp K_MUTE        &kp C_VOLUME_UP    &kp MINUS  &kp LEFT        &kp DOWN        &kp UP_ARROW  &kp RIGHT
&to 0    &to 6           &to 6              &to 4             &to 3              &kp EQUAL  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT
                                            &trans            &trans             &trans     &trans
            >;
        };
    };
};
